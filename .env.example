PORT=3000
ADMIN_PASSWORD=zmien-mnie
# Publiczny adres serwera (HTTPS), potrzebny Twilio do webhooków
PUBLIC_URL=https://callback.otoneso.pl
# Twilio (bez tych danych aplikacja działa w trybie DEMO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+48XXXXXXXXX
# Ile minut odczekać przed ponowieniem, gdy konsultant nie odbierze
RETRY_DELAY_MIN=2
# Adres, na który klienci piszą w sprawie zmiany planu (panel klienta, landing)
CONTACT_EMAIL=
# Klucz strony, której widget pokazuje się na landing page (domyślnie strona właściciela)
LANDING_SITE_KEY=
